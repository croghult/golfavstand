rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /courses/{courseId} {
      // Alla inloggade kan läsa delade banor
      allow read: if request.auth != null && resource.data.shared == true;
      // Ägaren kan läsa sina egna banor (även privata)
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      // Skapa: ownerId måste sättas till eget uid
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      // Uppdatera/ta bort: bara ägaren
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

  }
}
